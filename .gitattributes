# Normalize line endings to LF across all platforms.
# Prevents WSL2 / Windows mixed-mode churn (e.g. Edit from Linux side
# rewriting a file from CRLF to LF and producing a 280/280 diff for a
# 1-line content change).

* text=auto eol=lf

# Source code — always LF
*.cs        text eol=lf
*.shader    text eol=lf
*.shadergraph text eol=lf
*.compute   text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.glsl      text eol=lf

# Config / data — always LF
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf

# Unity asset metadata (YAML internally) — LF
*.meta      text eol=lf
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.controller text eol=lf
*.mat       text eol=lf
*.physicMaterial text eol=lf
*.anim      text eol=lf
*.playable  text eol=lf
*.signal    text eol=lf
*.lighting  text eol=lf
*.spriteatlas text eol=lf
*.terrainlayer text eol=lf
*.preset    text eol=lf
*.guiskin   text eol=lf
*.flare     text eol=lf
*.physicsMaterial2D text eol=lf
*.renderTexture text eol=lf
*.cubemap   text eol=lf
*.mixer     text eol=lf
*.overrideController text eol=lf
*.brush     text eol=lf

# Scripts / shell — must be LF (CRLF breaks shebang on Linux)
*.sh        text eol=lf
*.py        text eol=lf
*.ps1       text eol=crlf

# Windows batch — must be CRLF (cmd.exe parses CRLF)
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary — never modify
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.tga       binary
*.psd       binary
*.tif       binary
*.tiff      binary
*.exr       binary
*.hdr       binary
*.ico       binary

*.fbx       binary
*.obj       binary
*.blend     binary
*.dae       binary
*.3ds       binary

*.wav       binary
*.mp3       binary
*.ogg       binary
*.aiff      binary
*.aif       binary
*.mp4       binary
*.mov       binary
*.webm      binary

*.unitypackage binary
*.dll       binary
*.pdb       binary
*.exe       binary
*.so        binary
*.dylib     binary
*.zip       binary
*.7z        binary
*.rar       binary
*.tar       binary
*.gz        binary
*.bz2       binary

*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

